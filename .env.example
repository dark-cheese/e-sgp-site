# ============================================================
# CONFIGURAÇÕES PARA RENDER.COM
# ============================================================
# 
# Copie este arquivo para .env.local e preencha com seus valores
# Para usar no Render, defina estas variáveis nas Environment Variables
#

# ============== BANCO DE DADOS ==============
# Opção 1: DATABASE_URL (prioridade máxima)
# DATABASE_URL=mysql+pymysql://usuario:senha@host:porta/banco

# Opção 2: Variáveis individuais (se DATABASE_URL não estiver definida)
DB_USER=2026Iventario
DB_PASSWORD=Inventa@2025
DB_HOST=200.131.251.11
DB_PORT=3341
DB_NAME=2026ProjetoInv

# ============== FLASK ==============
FLASK_ENV=production
FLASK_DEBUG=False

# ============== PORTA ==============
# Render atribui a porta automaticamente, mas você pode definir:
PORT=5000

# ============== RENDER ==============
# Defina como true quando rodar no Render
RENDER=false
